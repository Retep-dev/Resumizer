# Free providers only. Resumizer never calls a paid inference API.
# production (default): only Groq's free plan, whose terms allow real users. evaluation: fictional resumes only.
AI_DEPLOYMENT=production
# Groq free plan: create the account without a payment method and turn on Zero Data Retention.
GROQ_API_KEY=
# Evaluation only (not used in production mode).
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
# Optional per-task chains, e.g. MODELS_REWRITE=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# Optional: the account's real quotas if they differ from Groq's published free plan
# MODEL_QUOTAS=groq:openai/gpt-oss-120b:rpd=1000:tpd=200000:tpm=8000
ANALYZE_LIMIT_PER_DAY=3
CHAT_LIMIT_PER_SESSION=10
CHAT_LIMIT_PER_DAY=20
LLM_TIMEOUT_SECONDS=60
HOST=0.0.0.0
PORT=8000
