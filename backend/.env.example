# Free providers only. Resumizer never calls a paid inference API.
# NVIDIA API Catalog trial key: its terms allow internal testing and evaluation only.
NVIDIA_API_KEY=nvapi-your-key-here
# Optional free tiers (create the account without a payment method; enable Groq's Zero Data Retention).
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Fast chain used by analysis and interview prep.
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODELS=openai/gpt-oss-20b
# Optional per-task chains, e.g. MODELS_REWRITE=groq:llama-3.3-70b-versatile,nvidia:nvidia/nemotron-3-ultra-550b-a55b
# Optional daily caps to stay inside free quotas, e.g. DAILY_REQUEST_CAPS=groq:900,nvidia:1000
LLM_TIMEOUT_SECONDS=60
HOST=0.0.0.0
PORT=8000
